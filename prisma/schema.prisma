generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Viaje {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  // Punto de origen
  origenLat       Float
  origenLng       Float
  origenDireccion Json?    // {calle, numero, colonia, cp, ciudad}

  // Punto de destino
  destinoLat      Float
  destinoLng      Float
  destinoDireccion Json?   // {calle, numero, colonia, cp, ciudad}

  // Datos del formulario
  gastoDiario       Float
  motivoViaje       String
  tiempoIda         Int?     // Minutos de ida
  tiempoRegreso     Int?     // Minutos de regreso
  mediosTransporte  Json     // Array de strings: ["linea1", "van", etc.]
  transbordosIda    Int      // 0, 1, 2 o 3
  transbordosRegreso Int     // 0, 1, 2 o 3
  satisfaccion      Int      // 1 a 5 (escala Likert)
}
