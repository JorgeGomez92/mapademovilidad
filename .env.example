# Base de datos PostgreSQL (Neon, Supabase, Railway, Docker local, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?schema=public"

# Secreto para firmar sesiones. Debe ser único, aleatorio, >= 32 caracteres.
# Generar: node -e 'console.log(require("node:crypto").randomBytes(48).toString("base64"))'
SESSION_SECRET=""

# Usuarios autorizados del dashboard. Formato: usuario:hash (separados por coma).
# El hash se genera con: node scripts/hash-password.mjs "contraseña"
# Ejemplo: DASHBOARD_USERS=admin:scrypt.abc...def...,otro@correo.com:scrypt.xyz...
DASHBOARD_USERS=""
